# Copy to backend/.env (git-ignored) and fill in what you have.

# AI provider — set ONE of these. With only GEMINI_API_KEY, Gemini is used automatically.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# SHOPDOCTOR_AI_PROVIDER=gemini        # or anthropic, to force a choice
# GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest   # tried in order when one is overloaded

# Real twin shops (Google Maps Platform key with "Places API (New)" enabled).
# Without it, twin shops are clearly labelled sample data.
# GOOGLE_MAPS_API_KEY=
